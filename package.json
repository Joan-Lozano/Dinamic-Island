{
  "name": "dinamic-island",
  "version": "0.1.0",
  "description": "Isla dinámica para Windows: multimedia, notificaciones y monitor de recursos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:mock": "electron . --mock",
    "test:ui": "node scripts/ui-smoke.js",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "license": "MIT",
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.dinamicisland.app",
    "productName": "Dinamic Island",
    "copyright": "Copyright © 2026 Joan Lozano",
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "asarUnpack": [
      "src/**/*.ps1"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "DinamicIsland-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dinamic Island",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082"
    }
  },
  "author": "Joan Atinohael Lozano Hidalgo"
}
