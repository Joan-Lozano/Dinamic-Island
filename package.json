{
  "name": "dinamic-island",
  "version": "0.1.0",
  "description": "Isla dinámica para Windows: multimedia (Spotify y navegador) y monitor de recursos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "start:mock": "electron . --mock",
    "test:ui": "node scripts/ui-smoke.js",
    "dist": "electron-builder --win"
  },
  "license": "MIT",
  "dependencies": {
    "systeminformation": "^5.33.16"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.dinamicisland.app",
    "productName": "Dinamic Island",
    "files": ["src/**/*", "assets/**/*"],
    "win": { "target": "nsis", "icon": "assets/icon.png" }
  }
}
